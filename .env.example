# ==============================================================================
# Golang Starterkit Environment Configuration Example
# Copy this file to .env and adjust the values for your local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_NAME="Golang Starterkit"
APP_ENV=local               # Options: local, development, staging, production
APP_DEBUG=true
APP_PORT=8080
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=postgres      # Options: postgres, mysql, sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=golang_db
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSL_MODE=disable         # Options for postgres: disable, require, verify-ca, verify-full
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=your-super-secure-jwt-secret-key-change-me
JWT_ACCESS_TOKEN_TTL=15m    # Access token time-to-live (e.g., 15m, 1h, 24h)
JWT_REFRESH_TOKEN_TTL=7d   # Refresh token time-to-live (e.g., 7d, 30d)

# ------------------------------------------------------------------------------
# Redis Configuration (For Caching, Queues, or Sessions)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Mail SMTP Configuration
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls         # Options: ssl, tls, none
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Log Configuration
# ------------------------------------------------------------------------------
LOG_LEVEL=debug             # Options: debug, info, warn, error, fatal
LOG_FORMAT=text             # Options: text, json
